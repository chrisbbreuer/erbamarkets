#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/       versioned X25519 encryption for .env files         /
#/       [how it works](https://stacksjs.com/encryption)   /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_PRODUCTION="x25519-public:MCowBQYDK2VuAyEALWzbLOG-qYAbkvQqN50bMBEDdfofUWF4x0idJGiJOhY"

# Secrets for the production environment.
#
# Encrypted with the public key below; the private half lives in .env.keys,
# which is not committed. `buddy deploy` decrypts these locally and ships the
# resolved values into the site env on the box — systemd reads a plain
# KEY=value file and cannot decrypt anything, so this is the only way a secret
# reaches the server without sitting in plaintext at both ends.
#
# Add one with: buddy env:set KEY value --env production
#
# Everything that is NOT a secret — hosts, ports, database paths, the app name
# — belongs in config/cloud.ts, where it is readable.

APP_KEY="encrypted:v2:"
TYPESENSE_API_KEY="encrypted:v2:eyJ2IjoyLCJlcGsiOiJNQ293QlFZREsyVnVBeUVBME44NkpBUGFnLVMtaURreVU4bUh6YWt3cGNBN0h3c0k2ak9tQmdSNVpUSSIsInNhbHQiOiJwemt4VXl6SUh1cl93MDB2LVItdUFRIiwibm9uY2UiOiJVSmcyZHM1aC1mc1pxMG5kIiwiY2lwaGVydGV4dCI6Ilk3ZlY2V0RtdXNKREcwTmRLUmhQMkRWZGhRUzY1bkJpeDNvdDhUd1FRa3MiLCJ0YWciOiJXbDV4WWJna2xybERCZngxUDhCSXFnIn0"
