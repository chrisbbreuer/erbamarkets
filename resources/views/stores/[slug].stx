                <p class="card-brand">{{ product.brand }}</p>
                <h3>{{ product.name }}</h3>
                <p class="card-potency mono">THC {{ product.thc }} &middot; CBD {{ product.cbd }}</p>
                <div class="card-foot">
                  <p class="card-price mono">{{ product.price }}<span class="card-unit"> / {{ product.unit }}</span></p>
                  <a href="/menu" class="btn btn-ghost btn-small">View</a>
                </div>
              </article>
            @endforeach
          </div>
        </div>
      </section>
