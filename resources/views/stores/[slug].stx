@section('content')
<script server>
/**
 * One dispensary.
 *
 * The old site had a hand-written page per room, which is how ERBA Sawtelle
 * ended up advertising "curbside pickup hours: TBA" for three years and how
 * the two pages came to disagree about which phone number reaches delivery.
 * This is one template over the store rows, so a change to the hours in the
 * database is a change on the page, the footer, the FAQ and the schema at once.
 *
 * An unknown slug falls back to the first room rather than 404ing, because the
 * only ways to get here are the nav, the footer and the old /erba-sawtelle
 * redirects - all of which point at rooms that exist.
 */
import { loadSiteModel } from '../../functions/site'

const { stores, sawtelle, westla, products, navCategories, navBrands, navFeature, navProductCount, navDeliveryMinimum } = await loadSiteModel()

const requested = String((typeof slug !== 'undefined' && slug) || params?.slug || '')
const store = stores.find(row => row.slug === requested) || stores[0]
const otherStore = stores.find(row => row.slug !== store.slug) || null

const pageTitle = `${store.name} - ${store.addressLine}, Los Angeles`
const pageDescription = `${store.name} at ${store.addressLine}, Los Angeles. Open ${store.storeHours}, delivery ${store.deliveryHours}, curbside pickup ${store.pickupHours}.`

/* Matterport scans, same ids the 360 page uses. */
const scans = {
  'erba-sawtelle': 'Saah6AfccvV',
  'erba-west-la': 'VvdNekd3BYv',
}
const tourUrl = scans[store.slug] ? `https://my.matterport.com/show/?m=${scans[store.slug]}` : ''

/* A handful of what is on the shelf, as a reason to keep scrolling. */
const shelf = products.filter(product => product.image).slice(0, 4)

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Store',
  'name': store.name,
  'image': `https://erba.stacksjs.com${store.image}`,
  'telephone': store.storePhone,
  'email': store.email,
  'url': `https://erba.stacksjs.com${store.url}`,
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': store.addressLine,
    'addressLocality': store.city,
    'addressRegion': store.state,
    'postalCode': store.postalCode,
    'addressCountry': 'US',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': store.latitude,
    'longitude': store.longitude,
  },
  'hasMap': store.mapUrl,
})
</script>

<script client>
/* Only the shared header needs client state on this page. */
const megaOpen = state(false)
const bagOpen = state(false)
const bagCount = state(0)
</script>

<template>
