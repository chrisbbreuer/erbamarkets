            <h1 class="rise">{{ store.name }}</h1>
            <p class="hero-sub rise rise-2">
              <a href="{{ store.mapUrl }}" target="_blank" rel="noopener">{{ store.address }}</a>
            </p>
            <div class="hero-actions rise rise-3">
              <a href="/menu" class="btn btn-primary">Order online</a>
              <a href="{{ store.mapUrl }}" target="_blank" rel="noopener" class="btn btn-ghost">Directions</a>
            </div>
          </div>

          <figure class="hero-figure rise rise-2">
            <img src="{{ store.image }}" alt="{{ store.name }}" width="1600" height="1067" fetchpriority="high" decoding="async">
          </figure>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="stores">
            <article class="store">
              <div class="store-body">
                <h2>Hours and contact</h2>

                <dl class="store-rows">
                  <div class="store-row"><dt>Store hours</dt><dd class="mono">{{ store.storeHours }}</dd></div>
                  <div class="store-row"><dt>Delivery</dt><dd class="mono">{{ store.deliveryHours }}</dd></div>
                  <div class="store-row"><dt>Curbside pickup</dt><dd class="mono">{{ store.pickupHours }}</dd></div>
                  <div class="store-row"><dt>Store phone</dt><dd class="mono"><a href="{{ store.storePhoneHref }}">{{ store.storePhone }}</a></dd></div>
                  <div class="store-row"><dt>Delivery phone</dt><dd class="mono"><a href="{{ store.deliveryPhoneHref }}">{{ store.deliveryPhone }}</a></dd></div>
                  <div class="store-row"><dt>Email</dt><dd class="mono"><a href="mailto:{{ store.email }}">{{ store.email }}</a></dd></div>
                  <div class="store-row"><dt>Delivery minimum</dt><dd class="mono">{{ store.deliveryMinimum }}</dd></div>
                  <div class="store-row"><dt>License</dt><dd class="mono">{{ store.license }}</dd></div>
                </dl>

                <div class="store-tags">
                  @foreach (store.amenities as amenity)
                    <span class="tag">{{ amenity }}</span>
                  @endforeach
                </div>

                <div class="store-actions">
                  <a href="/menu" class="btn btn-primary btn-small">Order online</a>
                  @if (tourUrl)
                    <a href="/tour" class="btn btn-ghost btn-small">360 tour</a>
                  @endif
                  <a href="/contact" class="btn btn-ghost btn-small">Contact</a>
                </div>
              </div>
            </article>

            <article class="store">
              <div class="store-body">
                <h2>Getting here</h2>
                <p class="section-note">
                  There is a lot with a limited number of spaces and street parking
                  nearby. Bring valid, non-expired government issued ID: 21 and over, or
                  18 with a California medical recommendation.
                </p>

                <div class="store-actions" style="margin-top: 1.75rem;">
                  <a href="{{ store.mapUrl }}" target="_blank" rel="noopener" class="btn btn-ghost btn-small">Open in Maps</a>
                  <a href="{{ store.storePhoneHref }}" class="btn btn-ghost btn-small">Call the room</a>
                </div>

                @if (otherStore)
                  <p class="section-note" style="margin-top: 2rem;">
                    Closer to {{ otherStore.shortName }}? That room is at
                    <a href="{{ otherStore.url }}">{{ otherStore.addressLine }}</a>,
                    open <span class="mono">{{ otherStore.storeHours }}</span>.
                  </p>
                @endif
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section" style="background: var(--ink-sunken);">
        <div class="shell">
          <div class="menu-top reveal">
            <div class="section-head">
              <p class="eyebrow">On the shelf</p>
              <h2>A few things in stock</h2>
            </div>
            <a href="/menu" class="btn btn-ghost btn-small">Browse all {{ navProductCount }}</a>
          </div>

          <div class="grid">
            @foreach (shelf as product)
              <article class="card">
                <div class="card-media">
                  <img src="{{ product.image }}" alt="{{ product.name }} by {{ product.brand }}" width="900" height="1100" loading="lazy" decoding="async">
                  <span class="card-strain on-media">{{ product.strain }}</span>
