<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@yield('title')</title>
    <meta name="description" content="@yield('description')">
    <link rel="canonical" href="https://www.erbamarkets.com/">

    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#0b0d0c">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="ERBA Markets">
    <meta property="og:url" content="https://www.erbamarkets.com/">
    <meta property="og:title" content="@yield('title')">
    <meta property="og:description" content="@yield('description')">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@yield('title')">
    <meta name="twitter:description" content="@yield('description')">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;800;900&family=Geist+Mono:wght@400;500&display=swap">

    <style>
      /*
       * ERBA, 2026.
       *
       * Direction: the room itself is dark, warm and quiet, and the product is
       * the only bright thing in it. So the page is one locked dark theme with
       * a single acid-green accent standing in for the plant. No second hue
       * anywhere, in any section.
       *
       * Shape rule, applied everywhere: buttons, pills and badges are full
       * radius; every panel, card, image and input is square. Nothing in
       * between, no 8px corners.
       *
       * Type: Geist for everything, Geist Mono only for numbers (potency,
       * price, hours) so figures line up in a column.
       */
      :root {
        color-scheme: dark;

        --ink: #0b0d0c;
        --ink-raised: #131614;
        --ink-sunken: #070908;
        --paper: #f3f2ed;
        --muted: #9ba09a;
        --faint: rgba(243, 242, 237, 0.10);
        --faint-strong: rgba(243, 242, 237, 0.22);
        --acid: #a8d84a;
        --acid-dim: #7fae2c;
        --on-acid: #0b0d0c;

        --shell: min(1440px, 100% - 3rem);

        /*
         * Atmospheric photography (hero, story, storefronts, bento) is pulled
         * back so the acid accent stays the brightest thing on the page.
         * Product shots deliberately do NOT use this: on a dispensary menu the
         * colour of the flower is information, not decoration.
         */
        --photo: saturate(0.82) contrast(1.06);
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--ink);
        color: var(--paper);
        font-family: Geist, ui-sans-serif, system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3 { margin: 0; font-weight: 800; letter-spacing: -0.03em; line-height: 1.02; }
      p { margin: 0; }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
      button { font: inherit; color: inherit; }

      .shell { width: var(--shell); margin-inline: auto; }
      .mono { font-family: 'Geist Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }

      .eyebrow {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--acid);
      }

      /* Buttons: the only round shapes on the page. */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.95rem 1.75rem;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        white-space: nowrap;
        cursor: pointer;
        transition: transform 0.18s var(--ease), background-color 0.18s var(--ease), border-color 0.18s var(--ease), color 0.18s var(--ease);
      }
      .btn:active { transform: scale(0.98); }
      .btn-primary { background: var(--acid); color: var(--on-acid); }
      .btn-primary:hover { background: #b9e563; }
      .btn-ghost { border-color: var(--faint-strong); color: var(--paper); background: transparent; }
      .btn-ghost:hover { border-color: var(--paper); background: rgba(243, 242, 237, 0.06); }
      .btn-small { padding: 0.6rem 1.1rem; font-size: 0.72rem; }
      .btn[disabled] { opacity: 0.5; cursor: not-allowed; }

      /* ---------- age gate ---------- */
      .gate {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: rgba(7, 9, 8, 0.94);
        backdrop-filter: blur(18px);
      }
      .gate-card { width: min(520px, 100%); text-align: center; }
      .gate-card h2 { font-size: clamp(2rem, 6vw, 3.25rem); text-transform: uppercase; }
      .gate-card p { margin-top: 1rem; color: var(--muted); }
      .gate-actions { margin-top: 2.25rem; display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
      .gate-legal { margin-top: 2rem; font-size: 0.75rem; color: var(--muted); }

      /* ---------- nav ---------- */
      .nav {
        position: sticky;
        top: 0;
        z-index: 40;
        height: 72px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid var(--faint);
        background: rgba(11, 13, 12, 0.86);
        backdrop-filter: blur(14px);
      }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; width: var(--shell); margin-inline: auto; }
      .wordmark { font-size: 1.45rem; font-weight: 900; letter-spacing: 0.3em; text-transform: uppercase; }
      .nav-links { display: none; gap: 2rem; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; }
      .nav-links a { color: var(--muted); transition: color 0.18s var(--ease); }
      .nav-links a:hover { color: var(--paper); }
      .nav-actions { display: flex; align-items: center; gap: 0.6rem; }
      .bag-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.1rem;
        border: 1px solid var(--faint-strong);
        border-radius: 999px;
        background: transparent;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        cursor: pointer;
      }
      .bag-button:hover { border-color: var(--paper); }
      .bag-count { min-width: 1.4rem; padding: 0 0.35rem; border-radius: 999px; background: var(--acid); color: var(--on-acid); font-weight: 700; }
      @media (min-width: 1024px) { .nav-links { display: flex; } }

      /* ---------- hero ---------- */
      .hero { position: relative; min-height: calc(100dvh - 72px); display: flex; align-items: flex-end; overflow: hidden; }
      .hero-media { position: absolute; inset: 0; }
      .hero-media img { width: 100%; height: 100%; object-fit: cover; filter: var(--photo) brightness(0.62); }
      .hero-media::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(7, 9, 8, 0.96) 4%, rgba(7, 9, 8, 0.35) 48%, rgba(7, 9, 8, 0.68) 100%);
      }
      .hero-body { position: relative; width: var(--shell); margin-inline: auto; padding: 5rem 0 4.5rem; }
      /*
       * Font scale is planned against the copy, not picked first: this
       * headline is seven words, so it sits two lines deep at desktop and the
       * CTAs stay above the fold.
       */
      .hero h1 {
        max-width: 24ch;
        font-size: clamp(2.35rem, 5.4vw, 4.9rem);
        text-transform: uppercase;
      }
      .hero p { margin-top: 1.5rem; max-width: 46ch; font-size: clamp(1rem, 1.6vw, 1.2rem); color: rgba(243, 242, 237, 0.82); }
      .hero-actions { margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }

      /* ---------- brand marquee ---------- */
      .brands { border-block: 1px solid var(--faint); padding: 1.9rem 0; overflow: hidden; }
      .brand-track { display: flex; gap: 4.5rem; width: max-content; animation: brand-pan 42s linear infinite; }
      .brand-track span {
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: rgba(243, 242, 237, 0.45);
        white-space: nowrap;
      }
      @keyframes brand-pan { to { transform: translateX(-50%); } }

      /* ---------- generic section ---------- */
      .section { padding: clamp(5rem, 11vw, 9rem) 0; }
      .section-head { display: flex; flex-direction: column; gap: 1.1rem; }
      /* `ch` here is measured against the headline's own size, not the body's. */
      .section-head h2 { max-width: 15ch; }
      .section-head h2 { font-size: clamp(2rem, 4.6vw, 3.6rem); text-transform: uppercase; }
      .section-note { max-width: 58ch; color: var(--muted); }

      /* ---------- menu ---------- */
      .menu-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 2rem; }
      .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .filter {
        padding: 0.6rem 1.15rem;
        border: 1px solid var(--faint-strong);
        border-radius: 999px;
        background: transparent;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        cursor: pointer;
        transition: color 0.18s var(--ease), border-color 0.18s var(--ease), background-color 0.18s var(--ease);
      }
      .filter:hover { color: var(--paper); border-color: var(--paper); }
      .filter[aria-pressed='true'] { background: var(--acid); border-color: var(--acid); color: var(--on-acid); }

      .grid {
        margin-top: 3.5rem;
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1px;
        background: var(--faint);
        border: 1px solid var(--faint);
      }
      @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (min-width: 1024px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

      /*
       * The filter hides cards in CSS rather than re-rendering the grid, so
       * every product stays in the server-rendered HTML for search engines
       * and for anyone browsing without scripts.
       */
      .grid[data-filter='flower'] .card:not([data-cat='flower']),
      .grid[data-filter='cartridges'] .card:not([data-cat='cartridges']),
      .grid[data-filter='edibles'] .card:not([data-cat='edibles']),
      .grid[data-filter='pre-rolls'] .card:not([data-cat='pre-rolls']),
      .grid[data-filter='concentrates'] .card:not([data-cat='concentrates']),
      .grid[data-filter='wellness'] .card:not([data-cat='wellness']) { display: none; }

      .card { display: flex; flex-direction: column; background: var(--ink); padding: 1.25rem; }
      .card-media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--ink-raised); }
      .card-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
      .card:hover .card-media img { transform: scale(1.04); }
      .card-strain {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.28rem 0.7rem;
        border-radius: 999px;
        background: rgba(7, 9, 8, 0.82);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--acid);
      }
      .card-brand { margin-top: 1.1rem; font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
      .card h3 { margin-top: 0.4rem; font-size: 1.05rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; }
      .card-potency { margin-top: 0.7rem; font-size: 0.72rem; color: var(--muted); }
      .card-foot { margin-top: auto; padding-top: 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
      .card-price { font-size: 1rem; font-weight: 600; }
      .card-price s { color: var(--muted); font-weight: 400; margin-right: 0.4rem; }
      .card-unit { color: var(--muted); font-weight: 400; }

      /* ---------- specials ---------- */
      .specials-rail {
        margin-top: 3.5rem;
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(280px, 1fr);
        gap: 1px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        background: var(--faint);
        border: 1px solid var(--faint);
        scrollbar-width: thin;
      }
      .special { scroll-snap-align: start; background: var(--ink); padding: 2rem 1.75rem 2.25rem; display: flex; flex-direction: column; min-height: 320px; }
      .special-day { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--acid); }
      .special h3 { margin-top: 1.1rem; font-size: 1.5rem; text-transform: uppercase; }
      .special-offer { margin-top: 0.9rem; color: rgba(243, 242, 237, 0.8); }
      .special-brands { margin-top: auto; padding-top: 1.5rem; font-size: 0.72rem; color: var(--muted); line-height: 1.7; }
      .special-store { margin-top: 0.6rem; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--acid); }

      /* ---------- philosophy ---------- */
      .story { display: grid; gap: 3.5rem; align-items: start; }
      @media (min-width: 1024px) { .story { grid-template-columns: 1.15fr 0.85fr; gap: 5rem; } }
      .story h2 { font-size: clamp(2.1rem, 5vw, 4.2rem); text-transform: uppercase; }
      .story-body { margin-top: 2.25rem; display: grid; gap: 1.5rem; max-width: 62ch; color: rgba(243, 242, 237, 0.78); font-size: 1.05rem; }
      .story-figure img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; filter: var(--photo) brightness(0.9); }
      @media (min-width: 1024px) { .story-figure { margin-top: 5rem; } }

      /* ---------- locations ---------- */
      .stores { margin-top: 3.5rem; display: grid; gap: 1px; background: var(--faint); border: 1px solid var(--faint); }
      @media (min-width: 900px) { .stores { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      .store { background: var(--ink); }
      .store-media { aspect-ratio: 16 / 10; overflow: hidden; }
      .store-media img { width: 100%; height: 100%; object-fit: cover; filter: var(--photo) brightness(0.8); }
      .store-body { padding: 2rem 1.75rem 2.25rem; }
      .store h3 { font-size: 1.7rem; text-transform: uppercase; }
      .store-address { margin-top: 0.6rem; color: var(--muted); }
      .store-address a:hover { color: var(--acid); }
      .store-rows { margin-top: 1.75rem; display: grid; gap: 0.85rem; }
      .store-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; padding-bottom: 0.85rem; border-bottom: 1px solid var(--faint); }
      .store-row dt { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
      .store-row dd { margin: 0; font-size: 0.95rem; text-align: right; }
      .store-tags { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .tag { padding: 0.3rem 0.75rem; border: 1px solid var(--faint-strong); border-radius: 999px; font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
      .store-actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }

      /* ---------- delivery bento ---------- */
      .bento { margin-top: 3.5rem; display: grid; gap: 1px; background: var(--faint); border: 1px solid var(--faint); grid-template-columns: repeat(1, minmax(0, 1fr)); }
      @media (min-width: 700px) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (min-width: 1100px) { .bento { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      .fact { background: var(--ink); padding: 2rem 1.75rem 2.25rem; min-height: 260px; display: flex; flex-direction: column; }
      .fact h3 { font-size: 1.25rem; text-transform: uppercase; }
      .fact p { margin-top: 0.9rem; color: var(--muted); }
      .fact--accent { background: var(--acid); color: var(--on-acid); }
      .fact--accent p { color: rgba(11, 13, 12, 0.74); }
      .fact--tint { background: var(--ink-raised); }
      .fact--image { position: relative; overflow: hidden; justify-content: flex-end; }
      .fact--image::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(7, 9, 8, 0.94) 12%, rgba(7, 9, 8, 0.55) 52%, rgba(7, 9, 8, 0.18) 100%);
      }
      .fact--image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: var(--photo) brightness(0.34); }
      .fact--image h3, .fact--image p { position: relative; z-index: 1; }
      .fact--image p { color: rgba(243, 242, 237, 0.88); }

      /* ---------- faq ---------- */
      .faq { margin-top: 3.5rem; display: grid; gap: 1px; background: var(--faint); border: 1px solid var(--faint); }
      @media (min-width: 800px) { .faq { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      .faq-item { background: var(--ink); padding: 1.75rem; }
      .faq-item h3 { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
      .faq-item p { margin-top: 0.7rem; color: var(--muted); }

      /* ---------- vip ---------- */
      .vip { border-top: 1px solid var(--faint); background: var(--ink-raised); }
      .vip-inner { padding: clamp(4rem, 9vw, 7rem) 0; display: grid; gap: 2.5rem; }
      @media (min-width: 900px) { .vip-inner { grid-template-columns: 1fr 1fr; align-items: center; gap: 5rem; } }
      .vip h2 { font-size: clamp(2rem, 4.4vw, 3.2rem); text-transform: uppercase; }
      .vip p { margin-top: 1.1rem; color: var(--muted); max-width: 44ch; }
      .field { display: flex; flex-direction: column; gap: 0.55rem; }
      .field label { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
      .field input {
        width: 100%;
        padding: 1rem 1.1rem;
        border: 1px solid var(--faint-strong);
        border-radius: 0;
        background: var(--ink);
        color: var(--paper);
        font: inherit;
      }
      .field input::placeholder { color: #7d827d; }
      .field input:focus-visible { outline: 2px solid var(--acid); outline-offset: 2px; border-color: var(--acid); }
      .vip-form { display: flex; flex-direction: column; gap: 1rem; }
      .vip-note { font-size: 0.78rem; color: var(--muted); }
      .vip-note[data-state='said'] { color: var(--acid); }

      /* ---------- footer ---------- */
      .footer { border-top: 1px solid var(--faint); padding: clamp(3.5rem, 7vw, 5.5rem) 0 3rem; }
      .footer-grid { display: grid; gap: 2.75rem; }
      @media (min-width: 800px) { .footer-grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 3rem; } }
      .footer h3 { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
      .footer ul { margin: 1.1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; font-size: 0.9rem; }
      .footer ul a:hover { color: var(--acid); }
      .footer-hours { margin-top: 1.1rem; font-size: 0.85rem; color: var(--muted); display: grid; gap: 0.35rem; }
      .footer-legal { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--faint); display: grid; gap: 1.25rem; font-size: 0.76rem; color: var(--muted); }
      @media (min-width: 900px) { .footer-legal { grid-template-columns: 2fr 1fr; align-items: start; gap: 3rem; } }
      .footer-social { display: flex; gap: 1.25rem; font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; }

      /* ---------- bag drawer ---------- */
      .drawer-scrim { position: fixed; inset: 0; z-index: 60; background: rgba(7, 9, 8, 0.7); backdrop-filter: blur(6px); }
      .drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        z-index: 61;
        width: min(440px, 100%);
        display: flex;
        flex-direction: column;
        background: var(--ink-raised);
        border-left: 1px solid var(--faint-strong);
      }
      .drawer-head { display: flex; align-items: center; justify-content: space-between; padding: 1.5rem; border-bottom: 1px solid var(--faint); }
      .drawer-head h2 { font-size: 1.05rem; letter-spacing: 0.18em; text-transform: uppercase; }
      .drawer-close { border: 0; background: transparent; cursor: pointer; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
      .drawer-close:hover { color: var(--paper); }
      .drawer-body { flex: 1; overflow-y: auto; padding: 1.5rem; display: grid; gap: 1.25rem; align-content: start; }
      .drawer-empty { color: var(--muted); }
      .line { display: grid; grid-template-columns: 64px 1fr auto; gap: 1rem; align-items: start; }
      .line img { width: 64px; height: 80px; object-fit: cover; background: var(--ink); }
      .line-name { font-size: 0.92rem; font-weight: 600; line-height: 1.3; }
      .line-meta { margin-top: 0.3rem; font-size: 0.75rem; color: var(--muted); }
      .line-remove { margin-top: 0.5rem; border: 0; background: transparent; padding: 0; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); cursor: pointer; }
      .line-remove:hover { color: var(--acid); }
      .drawer-foot { padding: 1.5rem; border-top: 1px solid var(--faint); display: grid; gap: 1rem; }
      .totals { display: grid; gap: 0.5rem; font-size: 0.88rem; }
      .totals div { display: flex; justify-content: space-between; }
      .totals .grand { padding-top: 0.6rem; border-top: 1px solid var(--faint); font-size: 1rem; font-weight: 600; }
      .switch { display: flex; gap: 0.4rem; }
      .switch button { flex: 1; padding: 0.7rem; border: 1px solid var(--faint-strong); border-radius: 999px; background: transparent; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); cursor: pointer; }
      .switch button[aria-pressed='true'] { background: var(--paper); border-color: var(--paper); color: var(--ink); }
      .drawer-note { font-size: 0.78rem; color: var(--acid); }
      .drawer-hint { font-size: 0.76rem; color: var(--muted); text-align: center; }
      .drawer-address { font-size: 0.78rem; color: var(--muted); line-height: 1.5; }

      /* Checkout sits in the drawer, so the fields are tighter than the VIP form. */
      .checkout { display: grid; gap: 0.85rem; }
      .checkout .field label { font-size: 0.64rem; }
      .checkout .field input { padding: 0.7rem 0.85rem; font-size: 0.92rem; }
      .field-row { display: grid; grid-template-columns: 1fr 0.6fr; gap: 0.6rem; }
      .drawer-confirm { padding: 1.5rem; text-align: center; display: grid; gap: 0.75rem; }
      .drawer-confirm strong { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 1.4rem; color: var(--acid); }

      /* ---------- delivery tracking ---------- */
      .track { display: grid; min-height: calc(100dvh - 72px); }
      /*
       * `grid-template-rows` is doing real work here. Without it the single
       * row is content-sized, the container's min-height leaves slack the row
       * never claims, and the map cell resolves to zero height: MapLibre
       * initialises into a 0px box and paints nothing.
       */
      @media (min-width: 900px) {
        .track {
          grid-template-columns: minmax(360px, 34%) 1fr;
          grid-template-rows: minmax(0, 1fr);
        }
      }

      .track-panel { padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 3rem); display: flex; flex-direction: column; gap: 1.5rem; border-right: 1px solid var(--faint); }
      .track-panel h1 { font-size: clamp(2rem, 4vw, 3rem); text-transform: uppercase; }
      .track-eta { color: rgba(243, 242, 237, 0.82); font-size: 1.05rem; }
      .track-eta strong { color: var(--acid); }

      .track-rows { margin: 0; display: grid; gap: 0.9rem; }
      .track-row { display: grid; gap: 0.3rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--faint); }
      .track-row dt { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
      .track-row dd { margin: 0; font-size: 0.98rem; }

      .track-help { display: grid; gap: 1rem; justify-items: start; color: var(--muted); }
      .track-legal { margin-top: auto; font-size: 0.76rem; color: var(--muted); }

      /*
       * The map is the only place on the page where a light surface appears.
       * OSM raster tiles are a light basemap, so they are pulled toward the
       * page's palette rather than left glowing white inside a dark shell.
       */
      .track-map { min-height: 55vh; background: var(--ink-raised); filter: grayscale(0.45) brightness(0.72) contrast(1.05); }
      @media (min-width: 900px) { .track-map { min-height: 420px; height: 100%; } }

      .track-map-fallback { padding: 2rem; color: var(--muted); max-width: 34ch; }

      .map-pin { width: 22px; height: 22px; border-radius: 999px; }
      .map-pin--home { background: var(--paper); border: 3px solid var(--ink); box-shadow: 0 0 0 2px var(--paper); }
      .map-pin--driver {
        background: var(--acid);
        border: 3px solid var(--ink);
        box-shadow: 0 0 0 2px var(--acid), 0 0 18px rgba(168, 216, 74, 0.55);
        transform: rotate(var(--heading, 0deg));
        transition: transform 0.4s var(--ease);
      }

      /* ---------- motion ---------- */
      /*
       * Two motions, both earning their place: the hero settles once on load
       * so the eye lands on the headline before the CTAs, and section blocks
       * fade up as they arrive so a long scroll has a rhythm. Everything is
       * transform and opacity only.
       */
      .rise { animation: rise 0.9s var(--ease) both; }
      .rise-2 { animation-delay: 0.1s; }
      .rise-3 { animation-delay: 0.2s; }

      @keyframes rise {
        from { opacity: 0; transform: translateY(26px); }
        to { opacity: 1; transform: none; }
      }

      /*
       * Scroll reveal, gated on real support. The default state is VISIBLE:
       * only a browser that can actually drive the timeline is allowed to hide
       * anything, so a browser without scroll-driven animations (or one that
       * paints before the timeline attaches) shows the content rather than a
       * blank section. The range ends early so a block is fully solid well
       * before it reaches the middle of the screen.
       */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          .reveal {
            animation: rise 0.8s var(--ease) both;
            animation-timeline: view();
            animation-range: entry 0% entry 45%;
          }
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .rise, .reveal { animation: none; opacity: 1; transform: none; }
        .brand-track { animation: none; }
        .card:hover .card-media img { transform: none; }
      }
    </style>
  </head>

  <body>
    @yield('content')
    @stack('scripts')
  </body>
</html>
