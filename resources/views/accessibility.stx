<script server>
/**
 * Accessibility statement.
 *
 * This is deliberately not a port of the old one. That page described a
 * third-party overlay widget - font resizing, contrast profiles, an "AI engine"
 * rewriting the DOM every 24 hours - and a separate statement for the Jane
 * menu. This site runs none of that: no overlay, no third-party menu iframe.
 * Republishing the old text would have claimed features that are not here,
 * which is worse for a screen reader user than claiming nothing.
 *
 * What is described below is what the site actually does, and the commitment
 * is the same WCAG 2.1 AA target the old statement named.
 */
import { loadSiteModel } from '../functions/site'

const pageDescription = 'How ERBA Markets approaches web accessibility, the standard we build to, and how to tell us when we have missed.'

const { stores, sawtelle, westla, navCategories, navBrands, navFeature, navProductCount, navDeliveryMinimum } = await loadSiteModel({ cookies: typeof cookies !== 'undefined' ? cookies : {}, query: typeof query !== 'undefined' ? query : {} })

const updated = 'February 2026'
</script>

