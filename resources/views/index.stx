          <div class="grid" :data-filter="activeCategory()">
            @foreach (products as product)
              <article class="card" data-cat="{{ product.category }}">
                <div class="card-media">
                  <img src="{{ product.image }}" alt="{{ product.name }} by {{ product.brand }}" width="900" height="1100" loading="lazy" decoding="async">
                  <span class="card-strain">{{ product.strain }}</span>
                </div>
