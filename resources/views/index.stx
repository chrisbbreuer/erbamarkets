<script server>
/**
 * ERBA Markets storefront.
 *
 * Everything a customer reads comes out of the database: stores, weekday
 * deals, brands and the menu itself. Nothing on this page is a hardcoded
 * price or a hardcoded phone number.
 *
 * Rows come back from the ORM in snake_case, so each query is mapped into a
 * small view model here and the markup below stays readable.
 */
const siteName = 'ERBA Markets'
const siteUrl = 'https://www.erbamarkets.com'
const siteDescription = 'The premier cannabis destination in Los Angeles. Two West LA dispensaries with free delivery, curbside pickup and online ordering.'

const money = (cents) => `$${(cents / 100).toFixed(2).replace(/\.00$/, '')}`

const storeRows = await Store.where('is_active', true).orderBy('display_order', 'asc').get()
const stores = storeRows.map(row => ({
  name: row.name,
  slug: row.slug,
  shortName: row.short_name,
  address: `${row.address_line}, ${row.city} ${row.state} ${row.postal_code}`,
  addressLine: row.address_line,
  storePhone: row.store_phone,
  storePhoneHref: `tel:+1${String(row.store_phone).replace(/\D/g, '')}`,
  deliveryPhone: row.delivery_phone,
  deliveryPhoneHref: `tel:+1${String(row.delivery_phone).replace(/\D/g, '')}`,
  email: row.email,
  license: row.license_number,
  storeHours: row.store_hours,
  deliveryHours: row.delivery_hours,
  pickupHours: row.pickup_hours,
  amenities: JSON.parse(row.amenities || '[]'),
  mapUrl: row.map_url,
  image: row.image_url,
  deliveryMinimum: money(row.delivery_minimum * 100),
}))

const categoryRows = await Category.where('is_active', true).orderBy('display_order', 'asc').get()
const categories = categoryRows.map(row => ({ name: row.name, slug: row.slug, description: row.description }))

const productRows = await Product.where('is_available', true).orderBy('is_featured', 'desc').get()
const categorySlugById = new Map(categoryRows.map(row => [row.id, row.slug]))
const brandRows = await Manufacturer.query().get()
const brandNameById = new Map(brandRows.map(row => [row.id, row.manufacturer]))

const products = productRows.map(row => ({
  name: row.name,
  slug: row.slug,
  description: row.description,
  category: categorySlugById.get(row.category_id) || 'flower',
  brand: brandNameById.get(row.manufacturer_id) || '',
  brandLine: row.brand_line,
  strain: row.strain_type,
  thc: row.thc_percentage ? `${Number(row.thc_percentage).toFixed(2)}%` : '',
  cbd: row.cbd_percentage ? `${Number(row.cbd_percentage).toFixed(2)}%` : '',
  unit: row.unit_size,
  price: money(row.price),
  wasPrice: row.compare_at_price > 0 ? money(row.compare_at_price) : '',
  image: row.image_url,
  rating: row.rating ? Number(row.rating).toFixed(1) : '',
  reviews: row.review_count,
}))

const brands = brandRows.map(row => row.manufacturer)

const specialRows = await Special.where('is_active', true).get()
const dayOrder = [1, 2, 3, 4, 5, 6, 0]
const specials = specialRows
  .slice()
  .sort((a, b) => dayOrder.indexOf(a.day_of_week) - dayOrder.indexOf(b.day_of_week))
  .map(row => ({
    day: row.day_label,
    short: String(row.day_label).slice(0, 3),
    title: row.title,
    offer: row.offer,
    brands: JSON.parse(row.brands || '[]'),
    storeOnly: row.store_slug ? (stores.find(store => store.slug === row.store_slug)?.shortName || '') : '',
  }))

const sawtelle = stores.find(store => store.slug === 'erba-sawtelle') || stores[0]
const westla = stores.find(store => store.slug === 'erba-west-la') || stores[stores.length - 1]

const deliveryFacts = [
  {
    title: 'No delivery fee',
    body: `Free to your door on orders over ${westla.deliveryMinimum}. We do not add a service charge on top.`,
    tone: 'accent',
  },
  {
    title: 'Curbside pickup',
    body: `Order ahead, park outside ${westla.shortName}, and we bring it out. You get a text when the bag is ready.`,
    image: '/images/erba/sawtelle-entrance.jpg',
  },
  {
    title: 'Cash, debit and credit',
    body: 'Debit needs a four digit PIN and carries a $3 bank processing fee. There is an ATM in both rooms.',
  },
  {
    title: '45 to 60 minutes',
    body: 'Typical time from checkout to doorstep. Order outside delivery hours and it waits in the queue for open.',
    tone: 'tint',
  },
  {
    title: 'Drivers take tips',
    body: 'Cash, or add it to the card when the driver arrives. They keep all of it.',
  },
  {
    title: 'Check your address',
    body: 'We cover most of the Westside. Enter your address at checkout and we confirm before charging anything.',
    image: '/images/erba/people.jpg',
  },
]

const faqs = [
  { q: 'What identification do you accept?', a: 'Any valid, non-expired government issued ID showing you are 21 or older.' },
  { q: 'Do you have parking?', a: 'Yes. Both rooms have a lot, and there is street parking nearby. Sawtelle also has valet.' },
  { q: 'Do you offer discounts?', a: 'Every day has a deal, and VIP list members get the drops first.' },
  { q: 'What if I order after delivery hours?', a: 'Your order holds in the queue and goes out when delivery opens the next morning.' },
]

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': stores.map(store => ({
    '@type': 'Store',
    'name': store.name,
    'url': siteUrl,
    'telephone': store.storePhone,
    'image': store.image,
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': store.addressLine,
      'addressLocality': 'Los Angeles',
      'addressRegion': 'CA',
      'postalCode': '90064',
      'addressCountry': 'US',
    },
  })),
})
</script>

<script client>
/**
 * Three pieces of state, and nothing else runs on the client.
 *
 * 1. The age gate, which California requires before anyone sees the menu.
 * 2. The menu filter, which sets a class on the grid so CSS does the hiding.
 *    Filtering in CSS keeps the whole catalog server-rendered and indexable.
 * 3. The bag, which is a real commerce Cart on the server, addressed by a
 *    token this browser keeps. Every mutation returns the recomputed bag, so
 *    the drawer never has to add up prices itself.
 */
/*
 * The gate answer is kept in a cookie rather than in memory, so a customer
 * confirms once a month instead of on every visit. It is a cookie and not
 * localStorage because the answer is the kind of thing a server may later need
 * to enforce, and because a cookie survives a hard reload before hydration.
 */
const ageOk = useCookie('erba_age_ok', { maxAge: 60 * 60 * 24 * 30 })
const gateOpen = state(true)
const gateRefused = state(false)

function acceptAge() {
  ageOk.set('1')
  gateOpen.set(false)
}

const activeCategory = state('all')

const bagToken = useLocalStorage('erba-bag-token', '')
const bagOpen = state(false)
const bagItems = state([])
const bagCount = state(0)
const bagSubtotal = state('$0')
const bagTotal = state('$0')
const bagTax = state('$0')
const bagMinimum = state(3000)
const bagSubtotalCents = state(0)
const bagBusy = state(false)
const bagNotice = state('')
const fulfillment = state('delivery')
const orderReference = state('')

const csrfToken = useCookie('X-CSRF-Token')

const belowMinimum = derived(() => fulfillment() === 'delivery' && bagSubtotalCents() > 0 && bagSubtotalCents() < bagMinimum())

function dollars(cents) {
  return `$${(cents / 100).toFixed(2).replace(/\.00$/, '')}`
}

function ensureToken() {
  if (!bagToken())
    bagToken.set(`bag_${crypto.randomUUID()}`)

  return bagToken()
}

async function callBag(path, payload) {
  bagBusy.set(true)

  try {
    const res = await fetch(path, {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'x-csrf-token': csrfToken() || '',
      },
      body: JSON.stringify({ token: ensureToken(), ...payload }),
    })

    const body = await res.json()

    if (!res.ok) {
      bagNotice.set(body?.message || 'That did not go through. Try again.')
      return null
    }

    return body?.data ?? body
  }
  catch {
    bagNotice.set('We could not reach the store. Check your connection and try again.')
    return null
  }
  finally {
    bagBusy.set(false)
  }
}

function applyBag(bag) {
  if (!bag)
    return

  bagItems.set(bag.items || [])
  bagCount.set(bag.count || 0)
  bagSubtotalCents.set(bag.subtotal || 0)
  bagSubtotal.set(dollars(bag.subtotal || 0))
  bagTax.set(dollars(bag.tax || 0))
  bagTotal.set(dollars(bag.total || 0))
  bagMinimum.set(bag.deliveryMinimum || 3000)
}

async function addToBag(slug) {
  bagNotice.set('')
  const bag = await callBag('/api/bag', { productSlug: slug, quantity: 1 })
  applyBag(bag)

  if (bag)
    bagOpen.set(true)
}

async function removeFromBag(slug) {
  bagNotice.set('')
  applyBag(await callBag('/api/bag/remove', { productSlug: slug }))
}

async function refreshBag() {
  if (!bagToken())
    return

  applyBag(await callBag('/api/bag/show', {}))
}

async function placeOrder() {
  bagNotice.set('')
  const result = await callBag('/api/orders', { fulfillment: fulfillment() })

  if (!result)
    return

  orderReference.set(result.reference)
  bagItems.set([])
  bagCount.set(0)
  bagSubtotalCents.set(0)
}

const vipEmail = state('')
const vipMessage = state('')
const vipBusy = state(false)

async function joinVip() {
  if (!vipEmail()) {
    vipMessage.set('Enter an email address first.')
    return
  }

  vipBusy.set(true)

  try {
    const res = await fetch('/api/vip', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': csrfToken() || '' },
      body: JSON.stringify({ email: vipEmail() }),
    })
    const body = await res.json()
    vipMessage.set((body?.data ?? body)?.message || 'Something went wrong. Try again.')

    if (res.ok)
      vipEmail.set('')
  }
  catch {
    vipMessage.set('We could not reach the list. Try again in a moment.')
  }
  finally {
    vipBusy.set(false)
  }
}

onMount(() => {
  if (ageOk() === '1')
    gateOpen.set(false)

  void refreshBag()
})
</script>

<template>
    <div data-stx-content>
    <script type="application/ld+json">{!! jsonLd !!}</script>
    <!-- California requires an age check before anyone sees a menu. -->
    <div class="gate" :if="gateOpen()" role="dialog" aria-modal="true" aria-labelledby="gate-title">
      <div class="gate-card">
        <p class="eyebrow">Welcome to ERBA</p>
        <h2 id="gate-title" style="margin-top: 1.25rem;">Are you 21 or older?</h2>
        <p :if="!gateRefused()">You need to be 21 or older, or 18 with a valid medical recommendation, to shop with us.</p>
        <p :if="gateRefused()">Sorry, you are not old enough to browse this menu. Come back when you are 21.</p>
        <div class="gate-actions" :if="!gateRefused()">
          <button type="button" class="btn btn-primary" @click="acceptAge()">Yes, I am 21</button>
          <button type="button" class="btn btn-ghost" @click="gateRefused.set(true)">No, I am not</button>
        </div>
        <p class="gate-legal">License {{ sawtelle.license }} and {{ westla.license }}. Keep out of reach of children.</p>
      </div>
    </div>

    <header class="nav">
      <div class="nav-inner">
        <a href="#top" class="wordmark">Erba</a>
        <nav class="nav-links" aria-label="Primary">
          <a href="#menu">Menu</a>
          <a href="#specials">Specials</a>
          <a href="#locations">Locations</a>
          <a href="#delivery">Delivery</a>
          <a href="#story">Story</a>
