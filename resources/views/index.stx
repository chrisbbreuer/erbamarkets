        </div>
        <div class="hero-body">
          <h1 class="rise">The premier cannabis destination in Los Angeles</h1>
          <p class="rise rise-2">Two West LA rooms, free delivery over {{ westla.deliveryMinimum }}, and curbside pickup. Order online in about two minutes.</p>
          <div class="hero-actions rise rise-3">
            <a href="#menu" class="btn btn-primary">Order online</a>
            <a href="#locations" class="btn btn-ghost">Find a store</a>
          </div>
        </div>
      </section>

      <section class="brands" aria-label="Brands we carry">
        <div class="brand-track">
          @foreach (brands as brand)
            <span>{{ brand }}</span>
          @endforeach
          @foreach (brands as brand)
            <span aria-hidden="true">{{ brand }}</span>
          @endforeach
        </div>
      </section>

      <section id="menu" class="section">
        <div class="shell">
          <div class="menu-top reveal">
            <div class="section-head">
              <p class="eyebrow">The menu</p>
              <h2>What is on the shelf right now</h2>
            </div>
            <div class="filters" role="group" aria-label="Filter the menu by category">
              <button type="button" class="filter" :aria-pressed="activeCategory() === 'all'" @click="activeCategory.set('all')">All</button>
              @foreach (categories as category)
                <button type="button" class="filter" :aria-pressed="activeCategory() === '{{ category.slug }}'" @click="activeCategory.set('{{ category.slug }}')">{{ category.name }}</button>
              @endforeach
