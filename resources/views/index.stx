@layout('erba')

@section('title')ERBA Markets - Cannabis dispensary and delivery in West Los Angeles@endsection

@section('description'){{ siteDescription }}@endsection

@section('canonical')https://erba.stacksjs.com/@endsection

@section('ogImage')https://erba.stacksjs.com/social/og.jpg@endsection

@section('content')
<script server>
/**
 * ERBA Markets storefront.
 *
 * Everything a customer reads comes out of the database: stores, weekday
 * deals, brands and the menu itself. Nothing on this page is a hardcoded
 * price or a hardcoded phone number.
 *
 * The joins and the snake_case mapping live in resources/functions/site.ts,
 * because the header and footer on every other route need the same shapes.
 */
import { loadSiteModel } from '../functions/site'

const siteUrl = 'https://www.erbamarkets.com'
const siteDescription = 'The premier cannabis destination in Los Angeles. Two West LA dispensaries with free delivery, curbside pickup and online ordering.'

const {
  stores,
  sawtelle,
  westla,
  products,
  brands,
  todaySpecial,
  navCategories,
  navBrands,
  navFeature,
  navProductCount,
  navDeliveryMinimum,
} = await loadSiteModel()

/* Eight for the homepage, not the whole catalogue: /menu owns the full list.
   Already ordered by is_featured, so this is the staff picks that have a
   photo, which is what the grid frame needs. */
const featuredProducts = products.filter(product => product.image).slice(0, 8)

const deliveryFacts = [
  {
    title: 'No delivery fee',
    body: `Free to your door on orders over ${westla.deliveryMinimum}. We do not add a service charge on top.`,
    tone: 'accent',
  },
  {
    title: 'Curbside pickup',
    body: `Order ahead, park outside ${westla.shortName}, and we bring it out. You get a text when the bag is ready.`,
    image: '/images/erba/sawtelle-entrance.jpg',
  },
  {
    title: 'Cash, debit and credit',
    body: 'Debit needs a four digit PIN and carries a $3 bank processing fee. There is an ATM in both rooms.',
  },
  {
    title: '45 to 60 minutes',
    body: 'Typical time from checkout to doorstep. Order outside delivery hours and it waits in the queue for open.',
    tone: 'tint',
  },
  {
    title: 'Drivers take tips',
    body: 'Cash, or add it to the card when the driver arrives. They keep all of it.',
  },
  {
    title: 'Check your address',
    body: 'We cover most of the Westside. Enter your address at checkout and we confirm before charging anything.',
    image: '/images/erba/people.jpg',
  },
]

const faqs = [
  { q: 'What identification do you accept?', a: 'Any valid, non-expired government issued ID showing you are 21 or older.' },
  { q: 'Do you have parking?', a: 'Yes. Both rooms have a lot, and there is street parking nearby. Sawtelle also has valet.' },
  { q: 'Do you offer discounts?', a: 'Every day has a deal, and VIP list members get the drops first.' },
  { q: 'What if I order after delivery hours?', a: 'Your order holds in the queue and goes out when delivery opens the next morning.' },
]

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': stores.map(store => ({
    '@type': 'Store',
    'name': store.name,
    'url': siteUrl,
    'telephone': store.storePhone,
    'image': store.image,
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': store.addressLine,
      'addressLocality': 'Los Angeles',
      'addressRegion': 'CA',
      'postalCode': '90064',
      'addressCountry': 'US',
    },
  })),
})
</script>

<script client>
/**
 * Three pieces of state, and nothing else runs on the client.
 *
 * 1. The age gate, which California requires before anyone sees the menu.
 * 2. The menu filter, which sets a class on the grid so CSS does the hiding.
 *    Filtering in CSS keeps the whole catalog server-rendered and indexable.
 * 3. The bag, which is a real commerce Cart on the server, addressed by a
 *    token this browser keeps. Every mutation returns the recomputed bag, so
 *    the drawer never has to add up prices itself.
 */
/*
 * The gate answer is kept in a cookie rather than in memory, so a customer
 * confirms once a month instead of on every visit. It is a cookie and not
 * localStorage because the answer is the kind of thing a server may later need
 * to enforce, and because a cookie survives a hard reload before hydration.
 */
const ageOk = useCookie('erba_age_ok', { maxAge: 60 * 60 * 24 * 30 })
const gateOpen = state(true)
const gateRefused = state(false)

function acceptAge() {
  ageOk.set('1')
  gateOpen.set(false)
}

const activeCategory = state('all')

// Read by partials/site-nav. The theme toggle needs no state here: stx's own
// pre-paint guard owns that, and a second owner would fight it.
const megaOpen = state(false)

const bagToken = useLocalStorage('erba-bag-token', '')
const bagOpen = state(false)
const bagItems = state([])
const bagCount = state(0)
const bagSubtotal = state('$0')
const bagTotal = state('$0')
const bagTax = state('$0')
const bagMinimum = state(3000)
const bagSubtotalCents = state(0)
const bagBusy = state(false)
const bagNotice = state('')
const fulfillment = state('delivery')
const orderReference = state('')
const orderTrackingUrl = state('')
const orderAddress = state('')

// Checkout details. Delivery needs somewhere to go; pickup needs to know who
// is collecting, because the bag is handed over against ID either way.
const checkoutName = state('')
const checkoutPhone = state('')
const checkoutAddress = state('')
const checkoutUnit = state('')
const checkoutPostalCode = state('')
const checkoutNotes = state('')

const checkoutReady = derived(() => {
  if (!checkoutName().trim() || !checkoutPhone().trim())
    return false

  return fulfillment() === 'pickup' || checkoutAddress().trim().length > 4
})

const csrfToken = useCookie('X-CSRF-Token')

const belowMinimum = derived(() => fulfillment() === 'delivery' && bagSubtotalCents() > 0 && bagSubtotalCents() < bagMinimum())

function dollars(cents) {
  return `$${(cents / 100).toFixed(2).replace(/\.00$/, '')}`
}

function ensureToken() {
  if (!bagToken())
    bagToken.set(`bag_${crypto.randomUUID()}`)

  return bagToken()
}

async function callBag(path, payload) {
  bagBusy.set(true)

  try {
    const res = await fetch(path, {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'x-csrf-token': csrfToken() || '',
      },
      body: JSON.stringify({ token: ensureToken(), ...payload }),
    })

    const body = await res.json()

    if (!res.ok) {
      bagNotice.set(body?.message || 'That did not go through. Try again.')
      return null
    }

    return body?.data ?? body
  }
  catch {
    bagNotice.set('We could not reach the store. Check your connection and try again.')
    return null
  }
  finally {
    bagBusy.set(false)
  }
}

function applyBag(bag) {
  if (!bag)
    return

  bagItems.set(bag.items || [])
  bagCount.set(bag.count || 0)
  bagSubtotalCents.set(bag.subtotal || 0)
  bagSubtotal.set(dollars(bag.subtotal || 0))
  bagTax.set(dollars(bag.tax || 0))
  bagTotal.set(dollars(bag.total || 0))
  bagMinimum.set(bag.deliveryMinimum || 3000)
}

async function addToBag(slug) {
  bagNotice.set('')
  const bag = await callBag('/api/bag', { productSlug: slug, quantity: 1 })
  applyBag(bag)

  if (bag)
    bagOpen.set(true)
}

async function removeFromBag(slug) {
  bagNotice.set('')
  applyBag(await callBag('/api/bag/remove', { productSlug: slug }))
}

async function refreshBag() {
  if (!bagToken())
    return

  applyBag(await callBag('/api/bag/show', {}))
}

async function placeOrder() {
  bagNotice.set('')

  const result = await callBag('/api/orders', {
    fulfillment: fulfillment(),
    name: checkoutName().trim(),
    phone: checkoutPhone().trim(),
    address: checkoutAddress().trim(),
    unit: checkoutUnit().trim(),
    postalCode: checkoutPostalCode().trim(),
    notes: checkoutNotes().trim(),
  })

  if (!result)
    return

  orderReference.set(result.reference)
  orderTrackingUrl.set(result.trackingUrl ?? '')
  orderAddress.set(result.address ?? '')
  bagItems.set([])
  bagCount.set(0)
  bagSubtotalCents.set(0)
}

const vipEmail = state('')
const vipMessage = state('')
const vipBusy = state(false)

async function joinVip() {
  if (!vipEmail()) {
    vipMessage.set('Enter an email address first.')
    return
  }

  vipBusy.set(true)

  try {
    const res = await fetch('/api/vip', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': csrfToken() || '' },
      body: JSON.stringify({ email: vipEmail() }),
    })
    const body = await res.json()
    vipMessage.set((body?.data ?? body)?.message || 'Something went wrong. Try again.')

    if (res.ok)
      vipEmail.set('')
  }
  catch {
    vipMessage.set('We could not reach the list. Try again in a moment.')
  }
  finally {
    vipBusy.set(false)
  }
}

onMount(() => {
  if (ageOk() === '1')
    gateOpen.set(false)

  void refreshBag()
})
</script>

<template>
    <div data-stx-content>
    <script type="application/ld+json">{!! jsonLd !!}</script>
    <!-- California requires an age check before anyone sees a menu. -->
    <div class="gate on-media" :if="gateOpen()" role="dialog" aria-modal="true" aria-labelledby="gate-title">
      <div class="gate-card">
        <p class="eyebrow">Welcome to ERBA</p>
        <h2 id="gate-title" style="margin-top: 1.25rem;">Are you 21 or older?</h2>
        <p :if="!gateRefused()">You need to be 21 or older, or 18 with a valid medical recommendation, to shop with us.</p>
        <p :if="gateRefused()">Sorry, you are not old enough to browse this menu. Come back when you are 21.</p>
        <div class="gate-actions" :if="!gateRefused()">
          <button type="button" class="btn btn-primary" @click="acceptAge()">Yes, I am 21</button>
          <button type="button" class="btn btn-ghost" @click="gateRefused.set(true)">No, I am not</button>
        </div>
        <p class="gate-legal">License {{ sawtelle.license }} and {{ westla.license }}. Keep out of reach of children.</p>
      </div>
    </div>

    @include('site-nav')

    <main id="top">
      {{--
        Asymmetric split rather than a full-bleed photo with the copy sitting
        on it. The old shape was a dark image block whatever the theme was, so
        the light theme never reached above the fold, and type over a
        photograph is the most dated arrangement a shop front can have.

        The type now sits on the page surface and follows the theme; only the
        image panel stays dark, which is where a dark room belongs.
      --}}
      <section class="hero">
        <div class="shell hero-inner">
          <div class="hero-copy">
            <h1 class="rise">The premier cannabis destination in Los&nbsp;Angeles</h1>
            <p class="hero-sub rise rise-2">
              Two West LA dispensaries, free delivery over {{ westla.deliveryMinimum }}, and curbside pickup.
            </p>
            <div class="hero-actions rise rise-3">
              <a href="/menu" class="btn btn-primary">Order online</a>
              <a href="#locations" class="btn btn-ghost">Find a store</a>
            </div>
          </div>

          <figure class="hero-figure rise rise-2">
            <img src="/images/erba/hero-inside.jpg" alt="Inside the ERBA dispensary on Sawtelle" width="1600" height="1067" fetchpriority="high" decoding="async">
          </figure>
        </div>
      </section>

      <section class="brands" aria-label="Brands we carry">
        <div class="brand-track">
          @foreach (brands as brand)
            <span>{{ brand }}</span>
          @endforeach
          @foreach (brands as brand)
            <span aria-hidden="true">{{ brand }}</span>
          @endforeach
        </div>
      </section>

      {{--
        A curated eight, not the whole catalogue. /menu owns the full list with
        its own search, filters and table view, and repeating all twenty here
        made the homepage long and gave the same job to two pages.

        The category filter went with it: filtering a shortlist of eight is
        busywork, and the pills belonged to the page that has something to
        filter.
      --}}
      <section id="menu" class="section">
        <div class="shell">
          <div class="menu-top reveal">
            <div class="section-head">
              <p class="eyebrow">The menu</p>
              <h2>What is on the shelf right now</h2>
            </div>
            <a href="/menu" class="btn btn-ghost btn-small">Browse all {{ navProductCount }}</a>
          </div>

          <div class="grid">
            @foreach (featuredProducts as product)
              <article class="card">
                <div class="card-media">
                  <img src="{{ product.image }}" alt="{{ product.name }} by {{ product.brand }}" width="900" height="1100" loading="lazy" decoding="async">
                  <span class="card-strain on-media">{{ product.strain }}</span>
                </div>
                <p class="card-brand">{{ product.brand }} {{ product.brandLine }}</p>
                <h3>{{ product.name }}</h3>
                <p class="card-potency mono">THC {{ product.thc }} &middot; CBD {{ product.cbd }}</p>
                <div class="card-foot">
                  <p class="card-price mono">
                    @if (product.wasPrice)
                      <s>{{ product.wasPrice }}</s>
                    @endif
                    {{ product.price }}<span class="card-unit"> / {{ product.unit }}</span>
                  </p>
                  <button type="button" class="btn btn-ghost btn-small" :disabled="bagBusy()" @click="addToBag('{{ product.slug }}')">Add</button>
                </div>
              </article>
            @endforeach
          </div>
        </div>
      </section>

      {{--
        Today, not the whole week. /specials carries the full calendar; the
        homepage's job is to say what is on right now and get out of the way.
      --}}
      <section id="specials" class="section" style="background: var(--ink-sunken);">
        <div class="shell">
          @if (todaySpecial)
            <div class="today-deal reveal">
              <div class="today-deal-copy">
                <p class="eyebrow">Today, {{ todaySpecial.day }}</p>
                <h2>{{ todaySpecial.title }}</h2>
                <p class="section-note">{{ todaySpecial.offer }}</p>
                <div class="today-deal-actions">
                  <a href="/menu" class="btn btn-primary btn-small">Order online</a>
                  <a href="/specials" class="btn btn-ghost btn-small">See the whole week</a>
                </div>
              </div>

              <ul class="today-deal-brands">
                @foreach (todaySpecial.brands as brand)
                  <li>{{ brand }}</li>
                @endforeach
              </ul>
            </div>
          @endif

          <p class="specials-fineprint">Prices and discounts change without notice, and deals run while supplies last. All sales are final.</p>
        </div>
      </section>

      <section id="story" class="section">
        <div class="shell story">
          <div class="reveal">
            <h2>Shopping should be experiential, not transactional</h2>
            <div class="story-body">
              <p>ERBA is what we think a dispensary should be. Everything inside is curated, from the room to the assortment, and every product is held to the same standard.</p>
              <p>CBD oil, edibles, pens or top shelf flower, we keep looking for brands worth carrying. Our staff come from different corners of this industry and are trained to give you a straight answer.</p>
              <p>No one should feel rushed or treated like a transaction. Word of mouth is our best asset, because the community is what matters. The purchase is easy. The visit is what you remember.</p>
            </div>
          </div>
          <figure class="story-figure reveal" style="margin-block: 0;">
            <img src="/images/erba/indoor-tree.jpg" alt="The indoor tree at the centre of the Sawtelle room" width="1200" height="1600" loading="lazy" decoding="async">
          </figure>
        </div>
      </section>

      <section id="locations" class="section" style="background: var(--ink-sunken);">
        <div class="shell">
          <div class="section-head reveal">
            <h2>Two dispensaries in West LA</h2>
          </div>

          <div class="stores">
            @foreach (stores as store)
              <article class="store reveal">
                <div class="store-media">
                  <img src="{{ store.image }}" alt="{{ store.name }}" width="1200" height="750" loading="lazy" decoding="async">
                </div>
                <div class="store-body">
                  <h3>{{ store.name }}</h3>
                  <p class="store-address"><a href="{{ store.mapUrl }}" target="_blank" rel="noopener">{{ store.address }}</a></p>

                  <dl class="store-rows">
                    <div class="store-row"><dt>Store hours</dt><dd class="mono">{{ store.storeHours }}</dd></div>
                    <div class="store-row"><dt>Delivery</dt><dd class="mono">{{ store.deliveryHours }}</dd></div>
                    <div class="store-row"><dt>Curbside pickup</dt><dd class="mono">{{ store.pickupHours }}</dd></div>
                    <div class="store-row"><dt>Store phone</dt><dd class="mono"><a href="{{ store.storePhoneHref }}">{{ store.storePhone }}</a></dd></div>
                    <div class="store-row"><dt>Delivery phone</dt><dd class="mono"><a href="{{ store.deliveryPhoneHref }}">{{ store.deliveryPhone }}</a></dd></div>
                    <div class="store-row"><dt>License</dt><dd class="mono">{{ store.license }}</dd></div>
                  </dl>

                  <div class="store-tags">
                    @foreach (store.amenities as amenity)
                      <span class="tag">{{ amenity }}</span>
                    @endforeach
                  </div>

                  <div class="store-actions">
                    <a href="{{ store.url }}" class="btn btn-ghost btn-small">Store details</a>
                    <a href="{{ store.mapUrl }}" target="_blank" rel="noopener" class="btn btn-ghost btn-small">Directions</a>
                    <a href="mailto:{{ store.email }}" class="btn btn-ghost btn-small">Email the team</a>
                  </div>
                </div>
              </article>
            @endforeach
          </div>
        </div>
      </section>

      <section id="delivery" class="section">
        <div class="shell">
          <div class="section-head reveal">
            <h2>Free delivery, no added fees</h2>
          </div>

          <div class="bento">
            @foreach (deliveryFacts as fact)
              <article class="fact reveal {{ fact.tone === 'accent' ? 'fact--accent' : '' }} {{ fact.tone === 'tint' ? 'fact--tint' : '' }} {{ fact.image ? 'fact--image on-media' : '' }}">
                @if (fact.image)
                  <img src="{{ fact.image }}" alt="" width="900" height="700" loading="lazy" decoding="async">
                @endif
                <h3>{{ fact.title }}</h3>
                <p>{{ fact.body }}</p>
              </article>
            @endforeach
          </div>

          <div class="faq">
            @foreach (faqs as faq)
              <div class="faq-item reveal">
                <h3>{{ faq.q }}</h3>
                <p>{{ faq.a }}</p>
              </div>
            @endforeach
          </div>
        </div>
      </section>

      <section class="vip">
        <div class="shell vip-inner">
          <div>
            <h2>Become an ERBA VIP</h2>
            <p>New arrivals, members-only pricing and event invitations, before they reach the shelf.</p>
          </div>
          <div class="vip-form">
            <div class="field">
              <label for="vip-email">Email address</label>
              <input id="vip-email" type="email" autocomplete="email" placeholder="you@example.com" x-model.trim="vipEmail">
            </div>
            <button type="button" class="btn btn-primary" :disabled="vipBusy()" @click="joinVip()">Join the list</button>
            <p class="vip-note" :if="!vipMessage()">We send a few emails a month and never sell your address.</p>
            <p class="vip-note" data-state="said" :if="vipMessage()">{{ vipMessage() }}</p>
          </div>
        </div>
      </section>
    </main>

    @include('site-footer')

    <!-- Bag drawer. The cart itself lives in the commerce tables; this reads it. -->
    <div class="drawer-scrim" :if="bagOpen()" @click="bagOpen.set(false)"></div>
    <aside class="drawer" :if="bagOpen()" aria-label="Your bag">
      <div class="drawer-head">
        <h2>Your bag</h2>
        <button type="button" class="drawer-close" @click="bagOpen.set(false)">Close</button>
      </div>

      <div class="drawer-confirm" :if="orderReference()">
        <p class="eyebrow">Order placed</p>
        <strong>{{ orderReference() }}</strong>
        <p class="drawer-empty">We are packing it now. You get a text when it is on the way, usually within 45 to 60 minutes.</p>
        <p class="drawer-address mono" :if="orderAddress()">{{ orderAddress() }}</p>
        <a class="btn btn-primary btn-small" :if="orderTrackingUrl()" :href="orderTrackingUrl()">Track it</a>
        <button type="button" class="btn btn-ghost btn-small" @click="orderReference.set('')">Start another order</button>
      </div>

      <div class="drawer-body" :if="!orderReference()">
        <p class="drawer-empty" :if="bagItems().length === 0">Nothing in here yet. Add something from the menu.</p>
        <div class="line" x-for="item in bagItems()">
          <img :src="item.image" :alt="item.name" width="64" height="80">
          <div>
            <p class="line-name">{{ item.name }}</p>
            <p class="line-meta mono">{{ item.quantity }} &times; {{ dollars(item.unitPrice) }}</p>
            <button type="button" class="line-remove" @click="removeFromBag(item.slug)">Remove</button>
          </div>
          <p class="mono">{{ dollars(item.linePrice) }}</p>
        </div>
      </div>

      <div class="drawer-foot" :if="!orderReference() && bagItems().length > 0">
        <div class="switch" role="group" aria-label="How you want it">
          <button type="button" :aria-pressed="fulfillment() === 'delivery'" @click="fulfillment.set('delivery')">Delivery</button>
          <button type="button" :aria-pressed="fulfillment() === 'pickup'" @click="fulfillment.set('pickup')">Pickup</button>
        </div>

        <div class="checkout">
          <div class="field">
            <label for="checkout-name">Name</label>
            <input id="checkout-name" type="text" autocomplete="name" placeholder="Who is collecting" x-model.trim="checkoutName">
          </div>

          <div class="field">
            <label for="checkout-phone">Mobile</label>
            <input id="checkout-phone" type="tel" autocomplete="tel" placeholder="310 555 0142" x-model.trim="checkoutPhone">
          </div>

          <div class="field" :if="fulfillment() === 'delivery'">
            <label for="checkout-address">Street address</label>
            <input id="checkout-address" type="text" autocomplete="street-address" placeholder="3821 Grand View Blvd" x-model.trim="checkoutAddress">
          </div>

          <div class="field-row" :if="fulfillment() === 'delivery'">
            <div class="field">
              <label for="checkout-unit">Apt or unit</label>
              <input id="checkout-unit" type="text" autocomplete="address-line2" placeholder="Optional" x-model.trim="checkoutUnit">
            </div>
            <div class="field">
              <label for="checkout-zip">ZIP</label>
              <input id="checkout-zip" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="90066" x-model.trim="checkoutPostalCode">
            </div>
          </div>

          <div class="field">
            <label for="checkout-notes">Notes for the driver</label>
            <input id="checkout-notes" type="text" placeholder="Gate code, buzzer, where to park" x-model.trim="checkoutNotes">
          </div>
        </div>

        <div class="totals mono">
          <div><span>Subtotal</span><span>{{ bagSubtotal() }}</span></div>
          <div><span>Tax and excise</span><span>{{ bagTax() }}</span></div>
          <div class="grand"><span>Total</span><span>{{ bagTotal() }}</span></div>
        </div>

        <p class="drawer-note" :if="belowMinimum()">Delivery starts at {{ dollars(bagMinimum()) }}. Add a little more, or switch to pickup.</p>
        <p class="drawer-note" :if="bagNotice()">{{ bagNotice() }}</p>

        <button type="button" class="btn btn-primary" :disabled="bagBusy() || belowMinimum() || !checkoutReady()" @click="placeOrder()">Place order</button>
        <p class="drawer-hint" :if="!checkoutReady()">Add your name, mobile{{ fulfillment() === 'delivery' ? ' and street address' : '' }} to check out.</p>
      </div>
    </aside>
    </div>
</template>
@endsection
