                  <img src="{{ fact.image }}" alt="" width="900" height="700" loading="lazy" decoding="async">
                @endif
                <h3>{{ fact.title }}</h3>
                <p>{{ fact.body }}</p>
              </article>
            @endforeach
          </div>
        </div>
      </section>

      <section class="section" style="background: var(--ink-sunken); padding-top: 0;">
        <div class="shell">
          <div class="section-head reveal" style="padding-top: clamp(3rem, 6vw, 5rem);">
            <p class="eyebrow">Hours by room</p>
            <h2>Who is running when</h2>
          </div>

          <div class="stores">
            @foreach (stores as store)
              <article class="store reveal">
                <div class="store-body">
                  <h3>{{ store.name }}</h3>
                  <p class="store-address"><a href="{{ store.mapUrl }}" target="_blank" rel="noopener">{{ store.address }}</a></p>

                  <dl class="store-rows">
                    <div class="store-row"><dt>Store hours</dt><dd class="mono">{{ store.storeHours }}</dd></div>
                    <div class="store-row"><dt>Delivery</dt><dd class="mono">{{ store.deliveryHours }}</dd></div>
                    <div class="store-row"><dt>Curbside pickup</dt><dd class="mono">{{ store.pickupHours }}</dd></div>
                    <div class="store-row"><dt>Delivery minimum</dt><dd class="mono">{{ store.deliveryMinimum }}</dd></div>
                    <div class="store-row"><dt>Delivery phone</dt><dd class="mono"><a href="{{ store.deliveryPhoneHref }}">{{ store.deliveryPhone }}</a></dd></div>
