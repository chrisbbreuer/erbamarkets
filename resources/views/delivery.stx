<script server>
/**
 * Delivery and pickup, in full.
 *
 * The homepage answers this in six tiles because that is as much as somebody
 * on their way to the menu wants. This page is the version the old site called
 * "quick facts": hours per room, what a driver can take as payment, what
 * happens to an order placed at midnight.
 *
 * Every number is read from the store rows. The one thing on this page that is
 * not in the database is the $3 debit fee, which belongs to the customer's
 * bank rather than to us.
 */
import { loadSiteModel } from '../functions/site'

const pageDescription = 'Free delivery across West Los Angeles with no service charge, plus curbside pickup. Hours, payment, timings and coverage.'

const { stores, sawtelle, westla, navCategories, navBrands, navFeature, navProductCount, navDeliveryMinimum } = await loadSiteModel()

const facts = [
  {
    title: 'No delivery fee',
    body: `Free to your door on orders over ${westla.deliveryMinimum}. There is no service charge on top, and the price on the menu already includes the day's discount.`,
    tone: 'accent',
  },
  {
    title: 'Curbside pickup',
    body: `Order ahead, park outside, and we bring it out. You get a text when the bag is ready. ${westla.shortName} runs pickup ${westla.pickupHours}.`,
    image: '/images/erba/sawtelle-entrance.jpg',
  },
  {
    title: '45 to 60 minutes',
    body: 'Typical time from checkout to doorstep. You get a link to follow the driver once the order leaves the room.',
    tone: 'tint',
  },
  {
    title: 'Cash, debit and credit',
    body: 'Debit needs a four digit PIN and carries a $3 bank processing fee. Call your bank if you have never set a PIN. There is an ATM in both rooms.',
  },
  {
    title: 'Drivers take tips',
    body: 'Cash, or add it to the card when the driver arrives. They keep all of it.',
  },
  {
    title: 'Ordered after hours?',
    body: 'Nothing is lost. The order holds in the queue and goes out when delivery opens again the next morning.',
    image: '/images/erba/people.jpg',
  },
]
</script>

<script client>
/* Only the shared header needs client state on this page. */
const megaOpen = state(false)
const bagOpen = state(false)
const bagCount = state(0)
</script>

