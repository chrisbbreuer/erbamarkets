<script server>
/**
 * Our story.
 *
 * The homepage carries a three-paragraph version of this, which is the right
 * length for someone on their way to the menu. This page is for the person who
 * followed the link, so it keeps the philosophy in full - the same three
 * headings the old site used, in sentence case rather than the all-caps slab
 * it was set in.
 */
import { loadSiteModel } from '../functions/site'

const pageDescription = 'Shopping should be experiential, not transactional. The idea behind ERBA, and how two rooms in West Los Angeles are put together.'

const { stores, sawtelle, westla, navCategories, navBrands, navFeature, navProductCount, navDeliveryMinimum } = await loadSiteModel()

const chapters = [
  {
    title: 'Our philosophy',
    image: '/images/erba/indoor-tree.jpg',
    alt: 'The indoor tree at the centre of the Sawtelle room',
    body: [
      'Shopping should be much more than transactional. It should be experiential. ERBA aims to be an evolution in aesthetic and in function, which is what we think the future of a dispensary looks like.',
      'The choices are many, and the quality of each product is held to the same standard. Everything inside is carefully curated, from the store design to the assortment on the shelf. There is an intention to everything you see.',
    ],
  },
  {
    title: 'A home for top tier brands',
    image: '/images/erba/detail-3.jpg',
    alt: 'Product detail on the shelf at ERBA',
    body: [
      'CBD oils, edibles, pens or top shelf flower, we stay diligent about finding new and exceptional brands and moving that needle, always catering to what you came in for.',
      'Our staff are diverse in their experience and are trained to give you clarity and a straight answer based on what you actually need, not on what we would like to move.',
    ],
  },
  {
    title: 'No one should feel rushed',
    image: '/images/erba/people.jpg',
    alt: 'Customers and staff at the ERBA counter',
    body: [
      'Every customer is different and should be treated that way. This is an industry with an ever expanding audience, and our goal is to be for all of it. The keys to that are fundamental to the business: service and variety, housed in a room worth standing in.',
      'That is the ethos at ERBA. We want word of mouth to be our greatest asset, because it is the community that matters to us, and it is through that prism that we hope you tell your friends and family. The transaction is easy. The experience is what you remember.',
    ],
  },
]
</script>

