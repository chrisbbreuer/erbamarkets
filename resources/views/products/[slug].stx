@layout('erba')

@section('title'){{ pageTitle }}@endsection

@section('description'){{ pageDescription }}@endsection

@section('canonical')https://erba.stacksjs.com{{ canonicalPath }}@endsection

@section('ogImage')https://erba.stacksjs.com/social/menu.jpg@endsection

@section('content')
<script server>
/**
 * One product.
 *
 * An unknown slug answers 404 rather than falling back to some other product.
 * A fallback returns 200 for a URL that names something the shop does not
 * sell, so a typo and a retired product both get indexed as real pages and a
 * crawler never learns they are gone.
 */
const { products, navCategories, navBrands, navFeature, navProductCount, navDeliveryMinimum, stores, selectedStore, selectedStoreSlug } = await loadSiteModel({ cookies: typeof cookies !== 'undefined' ? cookies : {}, query: typeof query !== 'undefined' ? query : {} })

const requested = String((typeof slug !== 'undefined' && slug) || params?.slug || '')
const found = products.find(item => item.slug === requested) || null

if (!found)
  setResponseStatus(404)

// Rendering still needs a shape. The markup below branches on `found`, so this
// only exists to keep the not-found branch from having to null-guard.
const product = found || products[0]

const pageTitle = found
  ? `${product.name} by ${product.brand} - ERBA Markets`
  : 'Product not found - ERBA Markets'

const pageDescription = !found
  ? 'That product is no longer on the menu.'
  : product.description
  ? String(product.description).slice(0, 160)
  : `${product.name} by ${product.brand}, ${product.thc} THC. Free delivery over ${navDeliveryMinimum} across West LA.`

/*
 * Four more from the same category, which is the question someone on a
 * product page is actually asking. Falls back to anything else in stock when
 * the category is thin, so the rail is never a lonely single card.
 */
const sameCategory = products.filter(item => item.category === product.category && item.slug !== product.slug)
const others = products.filter(item => item.category !== product.category && item.slug !== product.slug)
const related = [...sameCategory, ...others].slice(0, 4)

/* A 404 points at the menu; pointing it at some other product would tell a
   crawler this URL is that product. */
const canonicalPath = found ? `/products/${product.slug}` : '/menu'

/*
 * The other shops that have it, each with the separator that follows it.
 * Built here because the template has no way to ask "am I the last one", and
 * "West LA, and Sawtelle." reads as written English where a joined list with a
 * trailing comma does not.
 */
const withStock = found ? stores.filter(store => store.slug !== selectedStoreSlug && product.stockedAt.includes(store.slug)) : []
const otherStoresWithStock = withStock.map((store, index) => ({
  slug: store.slug,
  shortName: store.shortName,
  separator: index === withStock.length - 1 ? '.' : (index === withStock.length - 2 ? ' and ' : ', '),
}))

/*
 * Reviews, summary first.
 *
 * The counting lives in resources/functions/site.ts on top of
 * `commerce.products.reviews`, because the subtle part - leaving an unrated
 * review out of the average rather than averaging it in as a zero - is not
 * something to re-derive per page.
 */
const { reviewStats, reviews, averageStars, distribution, reviewsLabel } = found
  ? await loadProductReviews(product.id)
  : emptyProductReviews()

/*
 * Structured data, including what people said.
 *
 * schema.org draws the same distinction this page does: `ratingCount` counts
 * the ratings, `reviewCount` counts the reviews. A review with no stars is one
 * of the second and not the first, so the two numbers differ here and both are
 * honest.
 *
 * `aggregateRating` is omitted entirely when nothing is rated. Emitting one
 * with a count of zero is invalid and Google rejects the whole block for it,
 * which would cost the product its rich result rather than just its stars.
 */
const ratedReviews = reviews.filter(review => review.hasRating)

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': product.name,
  'description': product.description,
  'brand': { '@type': 'Brand', 'name': product.brand },
  'image': product.image ? `https://erba.stacksjs.com${product.image}` : undefined,
  'offers': {
    '@type': 'Offer',
    'price': (product.priceCents / 100).toFixed(2),
    'priceCurrency': 'USD',
    'availability': 'https://schema.org/InStock',
  },
  'aggregateRating': reviewStats.rated > 0
    ? {
        '@type': 'AggregateRating',
        'ratingValue': reviewStats.average,
        'ratingCount': reviewStats.rated,
        'reviewCount': reviewStats.total,
        'bestRating': 5,
        'worstRating': 1,
      }
    : undefined,
  // A handful, not all of them: the block is markup a crawler reads, and the
  // page below is the canonical copy.
  'review': reviews.slice(0, 5).map(review => ({
    '@type': 'Review',
    'author': { '@type': 'Person', 'name': review.author },
    'name': review.title || undefined,
    'reviewBody': review.content || undefined,
    // Absent for an unrated review rather than zero, which schema.org would
    // read as a score of nothing.
    'reviewRating': review.hasRating
      ? { '@type': 'Rating', 'ratingValue': review.rating, 'bestRating': 5, 'worstRating': 1 }
      : undefined,
  })),
})
</script>

<script client>
/* The bag, and the shared header. Same contract as every other page. */
const megaOpen = state(false)
const bagOpen = state(false)
const bagCount = state(0)
const bagBusy = state(false)
const added = state(false)

const bagToken = useLocalStorage('erba-bag-token', '')
const csrf = useCookie('X-CSRF-Token')

/**
 * Adds this product to the same server-side cart the menu writes to, so the
 * bag is one bag whichever page someone happens to be on.
 */
async function addToBag(productSlug) {
  if (bagBusy())
    return

  bagBusy.set(true)

  try {
    const res = await fetch('/api/bag', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() || '' },
      body: JSON.stringify({ token: bagToken() || '', productSlug, quantity: 1 }),
    })

    if (!res.ok)
      return

    const payload = await res.json()
    if (payload?.token)
      bagToken.set(payload.token)
    if (typeof payload?.count === 'number')
      bagCount.set(payload.count)

    added.set(true)
  }
  finally {
    bagBusy.set(false)
  }
}

/*
 * Writing a review.
 *
 * Stars and words are independently optional, so the button has to say which
 * of the three shapes is about to be sent - otherwise someone who tapped four
 * stars and typed nothing is left wondering whether pressing it does anything.
 * Zero means "no rating chosen", which is why Clear sets it back to zero
 * rather than to one.
 */
const reviewRating = state(0)
const reviewName = state('')
const reviewEmail = state('')
const reviewTitle = state('')
const reviewContent = state('')
const reviewBusy = state(false)
const reviewSaid = state('')
const reviewFailed = state(false)

function setRating(value) {
  reviewRating.set(value)
}

const reviewShape = derived(() => {
  const hasWords = Boolean(reviewTitle().trim() || reviewContent().trim())
  if (reviewRating() > 0 && hasWords) return 'both'
  if (reviewRating() > 0) return 'rating'
  if (hasWords) return 'comment'
  return 'empty'
})

/* Who you are is required; what you say is what is optional. */
const reviewReady = derived(() =>
  reviewShape() !== 'empty'
  && reviewName().trim().length > 1
  && /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(reviewEmail().trim()),
)

/*
 * The slug arrives as an argument rather than being read from a server
 * variable here. Inside `<script client>` a server value comes through the
 * bridge already JSON-encoded, so `'{{ product.slug }}'` wraps quotes around
 * quotes and posts the string `"blue-flame-og"` including them. Template
 * attribute interpolation does not do that, which is how `addToBag` above
 * gets its slug too.
 */
async function sendReview(productSlug) {
  if (!reviewReady() || reviewBusy())
    return

  reviewBusy.set(true)
  reviewFailed.set(false)

  try {
    const res = await fetch('/api/reviews', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() || '' },
      body: JSON.stringify({
        productSlug,
        name: reviewName().trim(),
        email: reviewEmail().trim(),
        // Null rather than 0, so an unrated review is not scored as nothing.
        rating: reviewRating() > 0 ? reviewRating() : null,
        title: reviewTitle().trim(),
        content: reviewContent().trim(),
      }),
    })

    const body = await res.json()

    if (!res.ok) {
      reviewFailed.set(true)
      reviewSaid.set(body?.message || 'That did not go through. Try again in a moment.')
      return
    }

    reviewSaid.set(body?.data?.message || body?.message || 'Thank you. Your review goes up once someone has read it.')
    reviewRating.set(0)
    reviewTitle.set('')
    reviewContent.set('')
  }
  catch {
    reviewFailed.set(true)
    reviewSaid.set('We could not reach the store. Check your connection and try again.')
  }
  finally {
    reviewBusy.set(false)
  }
}
</script>

<template>
  <div data-stx-content>
    @include('site-nav')

    <main id="top">
      @if (!found)
        <section class="section product-missing">
          <div class="shell">
            <p class="eyebrow">Not found</p>
            <h1>That product is not on the menu</h1>
            <p class="section-note">
              It may have sold out or been retired. The menu below is what is on the
              shelf right now.
            </p>
            <div class="product-actions">
              <a href="/menu" class="btn btn-primary">Browse the menu</a>
              <a href="/specials" class="btn btn-ghost">See this week's deals</a>
            </div>
          </div>
        </section>
      @endif

      @if (found)
      <nav class="crumbs" aria-label="Breadcrumb">
        <div class="shell">
          <a href="/menu">Menu</a>
          <span aria-hidden="true">/</span>
          <a href="/menu?category={{ product.category }}">{{ product.categoryName }}</a>
        </div>
      </nav>

      <section class="section product-section">
        <div class="shell product">
          <figure class="product-figure">
            <img src="{{ product.image }}" alt="{{ product.name }} by {{ product.brand }}" width="1200" height="1500" fetchpriority="high" decoding="async">
          </figure>

          <div class="product-body">
            <p class="product-brand">{{ product.brand }} {{ product.brandLine }}</p>
            <h1>{{ product.name }}</h1>

            <p class="product-price mono">
              @if (product.wasPrice)
                <s>{{ product.wasPrice }}</s>
              @endif
              {{ product.price }}<span class="product-unit"> / {{ product.unit }}</span>
            </p>

            @if (product.description)
              <p class="product-description">{{ product.description }}</p>
            @endif

            {{--
              A short spec list rather than a bordered table: five facts do not
              need a grid, and a hairline under every row is the tell.
            --}}
            <dl class="product-specs">
              @if (product.strain)
                <div><dt>Strain</dt><dd class="cap">{{ product.strain }}</dd></div>
              @endif
              @if (product.thc)
                <div><dt>THC</dt><dd class="mono">{{ product.thc }}</dd></div>
              @endif
              @if (product.cbd)
                <div><dt>CBD</dt><dd class="mono">{{ product.cbd }}</dd></div>
              @endif
              <div><dt>Size</dt><dd class="mono">{{ product.unit }}</dd></div>
              <div><dt>Category</dt><dd>{{ product.categoryName }}</dd></div>
            </dl>

            {{--
              Where this can be collected, before the button rather than after.

              A customer who adds to the bag and only then discovers the shop
              they picked does not stock it has been made to do work twice.
              Naming the other shop with a link that switches to it turns a
              dead end into one click.
            --}}
            @if (selectedStore && !selectedStore.ordersOnline)
              {{--
                No feed from this shop, so neither "in stock" nor "sold out" is
                a claim we can make. What is true is that they trade and answer
                the phone, so that is what it says.
              --}}
              <p class="product-stock">{{ selectedStore.shortName }} does not take online orders yet — call {{ selectedStore.storePhone }}, or switch to a shop that does.</p>
            @elseif (selectedStoreSlug && !product.inStockHere)
              <p class="product-stock product-stock-out">
                Sold out at {{ selectedStore.shortName }}.
                @if (product.alsoAt.length)
                  In stock at
                  @foreach (otherStoresWithStock as other)
                    <a href="/store/{{ other.slug }}/choose?next=/products/{{ product.slug }}">{{ other.shortName }}</a>{{ other.separator }}
                  @endforeach
                @endif
              </p>
            @elseif (selectedStoreSlug)
              <p class="product-stock">In stock at {{ selectedStore.shortName }}@if (product.alsoAt.length), and at {{ product.alsoAt.join(', ') }}@endif.</p>
            @else
              <p class="product-stock">Pick a shop in the header to see whether it is on the shelf today.</p>
            @endif

            <div class="product-actions">
              <button type="button" class="btn btn-primary" :disabled="bagBusy()" @click="addToBag('{{ product.slug }}')">
                <span :if="!added()">Add to bag</span>
                <span :else>Added</span>
              </button>
              <a href="/menu" class="btn btn-ghost">Back to the menu</a>
            </div>

            <p class="product-note">Free delivery over {{ navDeliveryMinimum }} across West LA, or collect from either room.</p>
          </div>
        </div>
      </section>

      @endif

      @if (found)
        <section class="section reviews-section" id="reviews" aria-labelledby="reviews-title">
          <div class="shell">
            <div class="section-head reviews-head">
              <p class="eyebrow">What people said</p>
              <h2 id="reviews-title">Reviews</h2>
            </div>

            <div class="reviews-layout">
              {{--
                Summary. A rating and a comment are separate things here, so
                the panel says how many of each rather than implying every
                review carries a score.
              --}}
              <aside class="review-summary">
                @if (reviewStats.rated)
                  <p class="review-average mono">{{ reviewStats.average }}</p>
                  <div class="stars stars-lg" role="img" aria-label="{{ reviewStats.average }} out of 5 stars">
                    @foreach (averageStars as star)
                      <span class="star {{ star.on ? 'star--on' : '' }}" aria-hidden="true">&#9733;</span>
                    @endforeach
                  </div>
                  <p class="review-count">{{ reviewsLabel }}, {{ reviewStats.rated }} with a rating</p>

                  <dl class="review-bars">
                    @foreach (distribution as row)
                      <div class="review-bar">
                        <dt class="mono">{{ row.star }}&#9733;</dt>
                        <dd>
                          <span class="review-bar-track"><span class="review-bar-fill" style="width: {{ row.width }}"></span></span>
                          <span class="review-bar-count mono">{{ row.count }}</span>
                        </dd>
                      </div>
                    @endforeach
                  </dl>

                  @if (reviewStats.commentsOnly)
                    <p class="review-note">
                      Plus {{ reviewStats.commentsOnly }} written without a rating. Those are
                      not counted in the average.
                    </p>
                  @endif
                @else
                  <p class="review-average mono">&mdash;</p>
                  <p class="review-count">{{ reviewsLabel }}</p>
                  <p class="review-note">Nobody has rated this yet. Be the first.</p>
                @endif
              </aside>

              <div class="review-main">
                @if (reviews.length)
                  <ol class="review-list">
                    @foreach (reviews as review)
                      <li class="review">
                        <div class="review-meta">
                          @if (review.featured)
                            <span class="tag review-pinned">Pick of the reviews</span>
                          @endif
                          @if (review.hasRating)
                            <div class="stars" role="img" aria-label="{{ review.rating }} out of 5 stars">
                              @foreach (review.stars as star)
                                <span class="star {{ star.on ? 'star--on' : '' }}" aria-hidden="true">&#9733;</span>
                              @endforeach
                            </div>
                          @endif
                          <span class="review-author">{{ review.author }}</span>
                          @if (review.verified)
                            <span class="tag review-verified">Verified purchase</span>
                          @endif
                          <span class="review-date mono">{{ review.date }}</span>
                        </div>

                        @if (review.title)
                          <h3 class="review-title">{{ review.title }}</h3>
                        @endif
                        @if (review.content)
                          <p class="review-body">{{ review.content }}</p>
                        @endif
                        @if (review.helpfulLabel)
                          <p class="review-helpful mono">{{ review.helpfulLabel }}</p>
                        @endif
                      </li>
                    @endforeach
                  </ol>
                @else
                  <p class="review-empty">No reviews on this one yet.</p>
                @endif

                {{--
                  Writing one. Stars and words are both optional on their own,
                  and the button copy says which of the three you are about to
                  send so nobody wonders whether a starless review counts.
                --}}
                <div class="form-card review-form" id="write-a-review">
                  <h3>Write a review</h3>
                  <p class="review-form-note">
                    Leave a rating, write a few words, or do both. Reviews go up once
                    someone has read them.
                  </p>

                  <fieldset class="review-stars-field">
                    <legend>Rating <span class="review-optional">optional</span></legend>
                    <div class="star-input">
                      @foreach ([1, 2, 3, 4, 5] as value)
                        <button
                          type="button"
                          class="star-button"
                          :class="reviewRating() >= {{ value }} ? 'star-button--on' : ''"
                          :aria-pressed="reviewRating() === {{ value }} ? 'true' : 'false'"
                          aria-label="{{ value }} stars"
                          @click="setRating({{ value }})"
                        >&#9733;</button>
                      @endforeach
                      <button type="button" class="star-clear" :if="reviewRating() > 0" @click="setRating(0)">Clear</button>
                    </div>
                  </fieldset>

                  <div class="form-grid form-grid-2">
                    <div class="field">
                      <label for="review-name">Name</label>
                      <input id="review-name" type="text" autocomplete="name" placeholder="How it appears on the review" x-model.trim="reviewName">
                    </div>
                    <div class="field">
                      <label for="review-email">Email</label>
                      <input id="review-email" type="email" autocomplete="email" placeholder="you@example.com" x-model.trim="reviewEmail">
                    </div>
                  </div>

                  <div class="field">
                    <label for="review-title">Headline <span class="review-optional">optional</span></label>
                    <input id="review-title" type="text" placeholder="Sum it up in a few words" x-model.trim="reviewTitle">
                  </div>

                  <div class="field">
                    <label for="review-content">Review <span class="review-optional">optional</span></label>
                    <textarea id="review-content" placeholder="How was it? What would you tell a friend?" x-model.trim="reviewContent"></textarea>
                  </div>

                  <div>
                    <button type="button" class="btn btn-primary" :disabled="reviewBusy() || !reviewReady()" @click="sendReview('{{ product.slug }}')">
                      <span :if="reviewShape() === 'rating'">Send rating</span>
                      <span :if="reviewShape() === 'comment'">Send review</span>
                      <span :if="reviewShape() === 'both'">Send rating and review</span>
                      <span :if="reviewShape() === 'empty'">Send</span>
                    </button>
                  </div>

                  <p class="form-status" :if="!reviewSaid()">
                    We publish your name and what you wrote, never your email address.
                  </p>
                  <p class="form-status" data-state="said" :if="reviewSaid() &amp;&amp; !reviewFailed()">{{ reviewSaid() }}</p>
                  <p class="form-status" data-state="failed" :if="reviewFailed()">{{ reviewSaid() }}</p>
                </div>
              </div>
            </div>
          </div>
        </section>
      @endif

      @if (found && related.length)
        <section class="section product-related-section">
          <div class="shell">
            <h2 class="product-related-title">More {{ product.categoryName }}</h2>

            <div class="grid product-related">
              @foreach (related as item)
                <a class="card" href="/products/{{ item.slug }}">
                  <div class="card-media">
                    <img src="{{ item.image }}" alt="{{ item.name }} by {{ item.brand }}" width="900" height="1100" loading="lazy" decoding="async">
                    @if (item.strain)
                      <span class="card-strain on-media">{{ item.strain }}</span>
                    @endif
                  </div>
                  <p class="card-brand">{{ item.brand }}</p>
                  <h3>{{ item.name }}</h3>
                  <div class="card-foot">
                    <p class="card-price mono">{{ item.price }}<span class="card-unit"> / {{ item.unit }}</span></p>
                  </div>
                </a>
              @endforeach
            </div>
          </div>
        </section>
      @endif
    </main>

    @include('site-footer')

    <script type="application/ld+json">{!! jsonLd !!}</script>
  </div>
</template>
@endsection
